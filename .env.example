POSTGRES_DB=workspace_ecommerce_dev
POSTGRES_USER=workspace_ecommerce
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432
API_PORT=5080
API_HTTPS_PORT=5443
ASPNETCORE_HTTPS_CERT_PASSWORD=CHANGE_ME_CERT_PASSWORD
ASPNETCORE_ENVIRONMENT=Development

AdminAuth__Email=admin@example.com
AdminAuth__Password=CHANGE_ME
Jwt__Issuer=WorkspaceEcommerce
Jwt__Audience=WorkspaceEcommerce.Admin
Jwt__SigningKey=CHANGE_ME_AT_LEAST_32_BYTES_LONG
Jwt__AccessTokenMinutes=60

# Local is intentionally Development-only. To exercise S3-compatible storage:
# docker compose --profile storage up
MediaStorage__Provider=Local
MediaStorage__PublicBaseUrl=http://localhost:5080
MediaStorage__Bucket=workspace-ecommerce-media
MediaStorage__ServiceUrl=http://minio:9000
MediaStorage__Region=us-east-1
MediaStorage__AccessKey=CHANGE_ME_MINIO_ACCESS_KEY
MediaStorage__SecretKey=CHANGE_ME_MINIO_SECRET_KEY
MediaStorage__ForcePathStyle=true
MINIO_ROOT_USER=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_SECRET_KEY
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
GoogleAuth__Enabled=false
GoogleAuth__AllowedClientIds__0=CHANGE_ME_GOOGLE_OAUTH_CLIENT_ID

TwoFactor__Issuer=WorkspaceEcommerce
TwoFactor__SetupLifetimeMinutes=10
TwoFactor__ChallengeLifetimeMinutes=5
TwoFactor__RecoveryCodeCount=10

Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:5174

MiniLogistics__BaseUrl=http://host.docker.internal:5221/api/v1/partner
MiniLogistics__ApiKey=CHANGE_ME_MINILOGISTICS_API_KEY
MiniLogistics__WebhookSecret=CHANGE_ME_MINILOGISTICS_WEBHOOK_SECRET
MiniLogistics__WebhookToleranceSeconds=300
MiniLogistics__OperationTimeoutSeconds=10
MiniLogistics__MaxRetryAttempts=2
MiniLogistics__RetryBaseDelayMilliseconds=250
MiniLogistics__CircuitBreakerFailureThreshold=5
MiniLogistics__CircuitBreakerBreakSeconds=30
MiniLogistics__CommandWorkerIntervalSeconds=15

Storefront__BaseUrl=http://localhost:5173

Payment__VNPay__TmnCode=CHANGE_ME_VNPAY_TMN_CODE
Payment__VNPay__HashSecret=CHANGE_ME_VNPAY_HASH_SECRET
Payment__VNPay__PaymentUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
Payment__VNPay__ReturnUrl=http://localhost:5080/api/payments/vnpay/return
Payment__VNPay__IpnUrl=http://localhost:5080/api/payments/vnpay/ipn
Payment__VNPay__Version=2.1.0
Payment__VNPay__Command=pay
Payment__VNPay__Locale=vn
Payment__VNPay__CurrCode=VND

APPLICATIONINSIGHTS_CONNECTION_STRING=CHANGE_ME_APPLICATIONINSIGHTS_CONNECTION_STRING
